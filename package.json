{
  "name": "momexpress",
  "version": "1.0.0",
  "private": true,
  "description": "MomExpress — your personal family delivery service.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild server/index.ts server/cli/users.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outdir=dist/server --out-extension:.js=.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.mjs",
    "users": "node --disable-warning=ExperimentalWarning dist/server/cli/users.mjs",
    "users:dev": "tsx server/cli/users.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
