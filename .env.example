# Copy to .env and adjust. Every setting is optional.

# Where the server listens.
PORT=3000
# HOST=0.0.0.0

# Where the SQLite database (and nothing else) is stored. Back this folder up.
# DATA_DIR=./data

# How long a device stays signed in without being used (days). Each use extends it.
# SESSION_DAYS=90

# Behind a reverse proxy (Caddy, nginx, a hosting platform), tell the server how
# many proxies to trust so it sees the real HTTPS scheme and client address.
# "1" is right for a single proxy in front. The default trusts only localhost.
# TRUST_PROXY=1

# Session cookies are marked Secure automatically when served over HTTPS.
# Force it on or off with true/false.
# COOKIE_SECURE=auto

# Web Push keys. Leave unset to have them generated once and stored in the
# database. Set VAPID_SUBJECT to a real contact address for your install.
# VAPID_SUBJECT=mailto:you@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Create the first two accounts automatically on a brand-new install
# (handy on hosts without a shell). Ignored once any account exists.
# INITIAL_MOM_USERNAME=mom
# INITIAL_MOM_PASSWORD=change-me-please
# INITIAL_MOM_NAME=Mom
# INITIAL_RUNNER_USERNAME=sam
# INITIAL_RUNNER_PASSWORD=change-me-too
# INITIAL_RUNNER_NAME=Sam
